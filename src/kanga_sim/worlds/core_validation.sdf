<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="core_validation">
    <physics name="dart_1ms" type="dart">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="ignition-gazebo-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-contact-system" name="gz::sim::systems::Contact"/>
    <gravity>0 0 -9.80665</gravity>
    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.8 0.85 0.9 1</background>
      <shadows>true</shadows>
    </scene>
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <direction>-0.4 0.2 -0.9</direction>
    </light>
    <model name="ground">
      <static>true</static>
      <link name="ground_link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>35 20</size></plane></geometry>
          <!-- Loose-sand baseline. Wheel-local anisotropy and compliance are
               applied by the rover simulation wrapper. -->
          <surface><friction><ode><mu>0.55</mu><mu2>0.55</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>35 20</size></plane></geometry>
          <material><diffuse>0.42 0.39 0.32 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Ten-degree, four-metre incline. -->
    <model name="incline">
      <static>true</static><pose>6 0 0.45 0 -0.174533 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>4 3 0.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>4 3 0.2</size></box></geometry><material><diffuse>0.38 0.36 0.31 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Alternating left/right wheel blocks exercise differential articulation. -->
    <model name="block_left_1"><static>true</static><pose>-2.0 0.36 0.075 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.45 0.38 0.15</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.45 0.38 0.15</size></box></geometry><material><diffuse>0.45 0.29 0.18 1</diffuse></material></visual></link></model>
    <model name="block_right_1"><static>true</static><pose>-1.1 -0.36 0.10 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.45 0.38 0.20</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.45 0.38 0.20</size></box></geometry><material><diffuse>0.45 0.29 0.18 1</diffuse></material></visual></link></model>
    <model name="block_left_2"><static>true</static><pose>-0.2 0.36 0.125 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.45 0.38 0.25</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.45 0.38 0.25</size></box></geometry><material><diffuse>0.45 0.29 0.18 1</diffuse></material></visual></link></model>
    <model name="block_right_2"><static>true</static><pose>0.7 -0.36 0.075 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.45 0.38 0.15</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.45 0.38 0.15</size></box></geometry><material><diffuse>0.45 0.29 0.18 1</diffuse></material></visual></link></model>

    <!-- A rounded berm crossing the course. -->
    <model name="berm"><static>true</static><pose>2.2 0 0.28 1.570796 0 0</pose><link name="link"><collision name="collision"><geometry><cylinder><radius>0.28</radius><length>3.0</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.28</radius><length>3.0</length></cylinder></geometry><material><diffuse>0.36 0.25 0.15 1</diffuse></material></visual></link></model>

    <!-- Primitive rocks intentionally avoid external model downloads. -->
    <model name="rock_1"><static>true</static><pose>10 -0.55 0.16 0 0.2 0.3</pose><link name="link"><collision name="collision"><geometry><ellipsoid><radii>0.35 0.24 0.16</radii></ellipsoid></geometry></collision><visual name="visual"><geometry><ellipsoid><radii>0.35 0.24 0.16</radii></ellipsoid></geometry><material><diffuse>0.31 0.30 0.28 1</diffuse></material></visual></link></model>
    <model name="rock_2"><static>true</static><pose>10.8 0.35 0.20 0.1 -0.15 -0.2</pose><link name="link"><collision name="collision"><geometry><ellipsoid><radii>0.42 0.30 0.20</radii></ellipsoid></geometry></collision><visual name="visual"><geometry><ellipsoid><radii>0.42 0.30 0.20</radii></ellipsoid></geometry><material><diffuse>0.34 0.32 0.29 1</diffuse></material></visual></link></model>
    <model name="rock_3"><static>true</static><pose>11.7 -0.15 0.13 -0.1 0.1 0.4</pose><link name="link"><collision name="collision"><geometry><ellipsoid><radii>0.29 0.22 0.13</radii></ellipsoid></geometry></collision><visual name="visual"><geometry><ellipsoid><radii>0.29 0.22 0.13</radii></ellipsoid></geometry><material><diffuse>0.29 0.28 0.26 1</diffuse></material></visual></link></model>
  </world>
</sdf>
