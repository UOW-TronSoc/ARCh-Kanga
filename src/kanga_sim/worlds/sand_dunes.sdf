<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="sand_dunes_core">
    <physics name="dart_1ms" type="dart">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="ignition-gazebo-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-contact-system" name="gz::sim::systems::Contact"/>

    <gravity>0 0 -9.80665</gravity>

    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.8 0.85 0.9 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <model name="ground">
      <static>true</static>
      <!-- Keep the generated terrain mesh at its native world coordinates.
           Both rendering and physics consume the same vertices and faces. -->
      <link name="ground_link">

        <collision name="ground_collision">
          <geometry>
            <!-- Collision and visual deliberately share this exact triangle
                 mesh. Fortress's independent heightmap implementations can
                 otherwise produce visibly different surfaces. -->
            <mesh>
              <uri>sand_dunes_terrain.obj</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>

          <!-- Loose-sand baseline. Wheel-local anisotropy and compliance are
               applied by the rover simulation wrapper. -->
          <surface>
            <friction>
              <ode>
                <mu>0.55</mu>
                <mu2>0.55</mu2>
              </ode>
            </friction>
          </surface>
        </collision>

        <visual name="ground_visual">
          <geometry>
            <mesh>
              <uri>sand_dunes_terrain.obj</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
          <material>
            <ambient>0.42 0.39 0.32 1</ambient>
            <diffuse>0.42 0.39 0.32 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>

      </link>
    </model>
  </world>
</sdf>
