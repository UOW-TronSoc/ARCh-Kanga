# Build the React operator UI, then copy static assets into the runtime image.
FROM node:20-bookworm-slim AS frontend
WORKDIR /src/basestation/frontend
COPY basestation/frontend/package.json basestation/frontend/package-lock.json ./
RUN npm ci
COPY basestation/frontend/ ./
RUN npm run build

# Basestation Python server + ROS base image.
FROM ros:humble-ros-base-jammy

ENV ROS_DISTRO=humble
ENV DEBIAN_FRONTEND=noninteractive
SHELL ["/bin/bash", "-c"]

RUN apt-get update \
 && apt-get install -y --no-install-recommends python3-pip \
 && rm -rf /var/lib/apt/lists/*

COPY basestation/requirements.txt /tmp/basestation-requirements.txt
RUN pip3 install --no-cache-dir -r /tmp/basestation-requirements.txt \
 && rm -f /tmp/basestation-requirements.txt

COPY basestation/docker-entrypoint.bash /usr/local/bin/basestation-entrypoint.bash
RUN chmod +x /usr/local/bin/basestation-entrypoint.bash

WORKDIR /workspace/basestation
COPY --from=frontend /src/basestation/server/static ./server/static

ENTRYPOINT ["/usr/local/bin/basestation-entrypoint.bash"]
CMD ["python3", "-m", "uvicorn", "--help"]
