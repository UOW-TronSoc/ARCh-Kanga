<?xml version="1.0" ?>
<robot name="core_2026_macro" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Reusable 2026 rover-core model with suspension.
       Params:
       - prefix: optional name prefix to avoid link/joint collisions
       - drivetrain_profile: compatible physical drivetrain profile
       - wheel_joint_effort_limit_nm: high simulation effort ceiling
       - wheel_joint_velocity_limit_rad_s: profile-derived wheel speed limit -->
  <xacro:macro
    name="core_2026"
    params="wheel_joint_effort_limit_nm wheel_joint_velocity_limit_rad_s prefix:='' drivetrain_profile:='drivetrain_2025'"
  >
    <!-- core_2026 describes the physical 2026 core, which retained the 2025
         drivetrain. Reject mismatched composition instead of silently
         publishing geometry for a different drivetrain. -->
    <xacro:unless value="${drivetrain_profile == 'drivetrain_2025'}">
      <xacro:property
        name="unsupported_drivetrain_profile"
        value="${xacro.fatal('core_2026 requires drivetrain_2025; got', drivetrain_profile)}"
        lazy_eval="false"
      />
    </xacro:unless>
    <!-- Base/root frame for full rover assemblies. -->
    <link name="${prefix}base_link"/>

    <joint name="${prefix}base_link_to_kanga_core" type="fixed">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}kanga_core"/>
      <origin xyz="0.0 0.0 0.39697" rpy="0 0 0"/>
    </joint>

    <!-- Main chassis body (core + antenna geometry). -->
    <link name="${prefix}kanga_core">
      <inertial>
        <origin xyz="-0.0805841 -0.0158605 0.124198" rpy="0 0 0"/>
        <mass value="8.4"/>
        <inertia ixx="0.334932" ixy="-0.0282303" ixz="0.0776441" iyy="0.445283" iyz="0.0534754" izz="0.396654"/>
      </inertial>
      <visual>
        <origin xyz="-0.0406693 -0 0" rpy="0 0 1.5708"/>
        <geometry>
          <mesh filename="package://kanga_core_description/meshes/core_2026/core.stl"/>
        </geometry>
        <material name="core_material">
          <color rgba="0.701961 0.701961 0.701961 1"/>
        </material>
      </visual>
      <!-- Simplified chassis envelope; detailed mesh remains visual-only. -->
      <collision>
        <origin xyz="0.03833 0 0.0614" rpy="0 0 0"/>
        <geometry>
          <box size="0.683 0.3822 0.1228"/>
        </geometry>
      </collision>
      <!-- Rear LED/e-stop protrusions above the main chassis. -->
      <collision>
        <origin xyz="-0.24116 -0.00339 0.2147" rpy="0 0 0"/>
        <geometry>
          <box size="0.070 0.2583 0.1838"/>
        </geometry>
      </collision>
      <visual>
        <origin xyz="-0.0406693 -0 0" rpy="0 -0 1.5708"/>
        <geometry>
          <mesh filename="package://kanga_core_description/meshes/core_2026/antenna.stl"/>
        </geometry>
        <material name="antenna_material">
          <color rgba="0.901961 0.901961 0.901961 1"/>
        </material>
      </visual>
      <!-- Antenna mast cylinder derived from the visual-mesh envelope. -->
      <collision>
        <origin xyz="-0.24116 -0.19617 0.6196" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.01275" length="1.131"/>
        </geometry>
      </collision>
    </link>

    <link name="${prefix}top_payload_mount">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="1e-9"/>
        <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
      </inertial>
    </link>
    <joint name="${prefix}top_payload_mount_frame" type="fixed">
      <origin xyz="0.379844 -0.1575 0.1216" rpy="-0 0 0"/>
      <parent link="${prefix}kanga_core"/>
      <child link="${prefix}top_payload_mount"/>
      <axis xyz="0 0 0"/>
    </joint>

    <link name="${prefix}front_payload_mount">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="1e-9"/>
        <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
      </inertial>
    </link>
    <joint name="${prefix}front_payload_mount_frame" type="fixed">
      <origin xyz="0.158499 -0 0.0116" rpy="0 0 0"/>
      <parent link="${prefix}kanga_core"/>
      <child link="${prefix}front_payload_mount"/>
      <axis xyz="0 0 0"/>
    </joint>

    <link name="${prefix}left_suspension">
      <inertial>
        <origin xyz="-0.132214 -0.267383 -0.0630324" rpy="0 0 0"/>
        <mass value="9"/>
        <inertia ixx="0.143475" ixy="-0.0477444" ixz="-0.00738433" iyy="1.29898" iyz="-0.0240894" izz="1.38116"/>
      </inertial>
      <visual>
        <origin xyz="-0.189168 -0.0616 0.1911" rpy="-1.5708 1.5708 0"/>
        <geometry>
          <mesh filename="package://kanga_core_description/meshes/core_2026/left_suspension.stl"/>
        </geometry>
        <material name="left_suspension_material">
          <color rgba="0.701961 0.701961 0.701961 1"/>
        </material>
      </visual>
      <!-- Two straight suspension arms offset into the linkage plane. -->
      <collision>
        <origin xyz="0.139957 -0.166795 -0.0334" rpy="0 1.5708 -0.872665"/>
        <geometry>
          <cylinder radius="0.025" length="0.481171"/>
        </geometry>
      </collision>
      <collision>
        <origin xyz="-0.289321 -0.167040 -0.0334" rpy="0 1.5708 -2.617994"/>
        <geometry>
          <cylinder radius="0.025" length="0.698804"/>
        </geometry>
      </collision>
      <!-- Shared suspension-arm pivot barrel. -->
      <collision>
        <origin xyz="0 -0.00286 0.0026" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.026" length="0.112"/>
        </geometry>
      </collision>
      <!-- Front and rear drivetrain housings. -->
      <collision>
        <origin xyz="0.279914 -0.333589 -0.090925" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.065" length="0.2275"/>
        </geometry>
      </collision>
      <collision>
        <origin xyz="-0.578642 -0.334079 -0.090925" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.065" length="0.2275"/>
        </geometry>
      </collision>
    </link>

    <link name="${prefix}wheel_fl">
      <inertial>
        <origin xyz="8.20141e-07 4.19108e-07 0.0294338" rpy="0 0 0"/>
        <mass value="0.7"/>
        <inertia ixx="0.00536519" ixy="2.6367e-08" ixz="3.55462e-07" iyy="0.00536521" iyz="7.378e-09" izz="0.00759451"/>
      </inertial>
      <visual>
        <origin xyz="0 -0 -0.05" rpy="-1.5708 0 0"/>
        <geometry>
          <mesh filename="package://kanga_core_description/meshes/core_2026/wheel_b.stl"/>
        </geometry>
        <material name="wheel_b_material">
          <color rgba="0.929412 0.0392157 0 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0.04" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.125" length="0.18"/>
        </geometry>
      </collision>
    </link>
    <joint name="${prefix}wheel_fl_joint" type="continuous">
      <origin xyz="0.279914 -0.333589 -0.204675" rpy="0 0 0"/>
      <parent link="${prefix}left_suspension"/>
      <child link="${prefix}wheel_fl"/>
      <axis xyz="0 0 -1"/>
      <limit effort="${wheel_joint_effort_limit_nm}" velocity="${wheel_joint_velocity_limit_rad_s}"/>
    </joint>

    <link name="${prefix}wheel_bl">
      <inertial>
        <origin xyz="1.69548e-06 -4.25166e-07 0.0294802" rpy="0 0 0"/>
        <mass value="0.7"/>
        <inertia ixx="0.0053658" ixy="2.7862e-08" ixz="3.79976e-07" iyy="0.00536582" iyz="-5.263e-09" izz="0.00759416"/>
      </inertial>
      <visual>
        <origin xyz="0 0 -0.05" rpy="-1.5708 -0 0"/>
        <geometry>
          <mesh filename="package://kanga_core_description/meshes/core_2026/wheel_a.stl"/>
        </geometry>
        <material name="wheel_a_material">
          <color rgba="0.929412 0.0392157 0 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0.04" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.125" length="0.18"/>
        </geometry>
      </collision>
    </link>
    <joint name="${prefix}wheel_bl_joint" type="continuous">
      <origin xyz="-0.578642 -0.334079 -0.204675" rpy="0 0 0"/>
      <parent link="${prefix}left_suspension"/>
      <child link="${prefix}wheel_bl"/>
      <axis xyz="0 0 -1"/>
      <limit effort="${wheel_joint_effort_limit_nm}" velocity="${wheel_joint_velocity_limit_rad_s}"/>
    </joint>

    <!-- Physical articulation range; state mapping lives in kanga_core_microcontroller. -->
    <joint name="${prefix}left_suspension_joint" type="revolute">
      <origin xyz="0.148499 0.1911 0.0616" rpy="1.5708 0 0"/>
      <parent link="${prefix}kanga_core"/>
      <child link="${prefix}left_suspension"/>
      <axis xyz="0 0 1"/>
      <limit effort="0" velocity="0" lower="-0.5235987755982988" upper="0.5235987755982988"/>
    </joint>

    <link name="${prefix}right_suspension">
      <inertial>
        <origin xyz="0.134107 -0.26778 -0.0627896" rpy="0 0 0"/>
        <mass value="9"/>
        <inertia ixx="0.143252" ixy="0.0492184" ixz="0.00651663" iyy="1.30123" iyz="-0.0237955" izz="1.38328"/>
      </inertial>
      <visual>
        <origin xyz="0.189168 -0.0616 0.1911" rpy="-1.5708 -1.5708 0"/>
        <geometry>
          <mesh filename="package://kanga_core_description/meshes/core_2026/right_suspension.stl"/>
        </geometry>
        <material name="right_suspension_material">
          <color rgba="0.701961 0.701961 0.701961 1"/>
        </material>
      </visual>
      <!-- Two straight suspension arms offset into the linkage plane. -->
      <collision>
        <origin xyz="-0.139957 -0.166795 -0.0334" rpy="0 1.5708 -2.268927"/>
        <geometry>
          <cylinder radius="0.025" length="0.481150"/>
        </geometry>
      </collision>
      <collision>
        <origin xyz="0.289321 -0.167040 -0.0334" rpy="0 1.5708 -0.523599"/>
        <geometry>
          <cylinder radius="0.025" length="0.698789"/>
        </geometry>
      </collision>
      <!-- Shared suspension-arm pivot barrel. -->
      <collision>
        <origin xyz="0 -0.00286 0.0026" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.026" length="0.112"/>
        </geometry>
      </collision>
      <!-- Front and rear drivetrain housings. -->
      <collision>
        <origin xyz="-0.279914 -0.333589 -0.090925" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.065" length="0.2275"/>
        </geometry>
      </collision>
      <collision>
        <origin xyz="0.578642 -0.334079 -0.090925" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.065" length="0.2275"/>
        </geometry>
      </collision>
    </link>

    <link name="${prefix}wheel_fr">
      <inertial>
        <origin xyz="1.69548e-06 -4.25166e-07 0.0294802" rpy="0 0 0"/>
        <mass value="0.7"/>
        <inertia ixx="0.0053658" ixy="2.7862e-08" ixz="3.79976e-07" iyy="0.00536582" iyz="-5.263e-09" izz="0.00759416"/>
      </inertial>
      <visual>
        <origin xyz="0 0 -0.05" rpy="-1.5708 -0 0"/>
        <geometry>
          <mesh filename="package://kanga_core_description/meshes/core_2026/wheel_a.stl"/>
        </geometry>
        <material name="wheel_a_2_material">
          <color rgba="0.929412 0.0392157 0 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0.04" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.125" length="0.18"/>
        </geometry>
      </collision>
    </link>
    <joint name="${prefix}wheel_fr_joint" type="continuous">
      <origin xyz="-0.279914 -0.333589 -0.204625" rpy="0 0 0"/>
      <parent link="${prefix}right_suspension"/>
      <child link="${prefix}wheel_fr"/>
      <!-- The mirrored right-suspension frame reverses local Z. Use +Z so
           positive joint velocity means rover-forward on every wheel. -->
      <axis xyz="0 0 1"/>
      <limit effort="${wheel_joint_effort_limit_nm}" velocity="${wheel_joint_velocity_limit_rad_s}"/>
    </joint>

    <link name="${prefix}wheel_br">
      <inertial>
        <origin xyz="8.20141e-07 4.19108e-07 0.0294338" rpy="0 0 0"/>
        <mass value="0.7"/>
        <inertia ixx="0.00536519" ixy="2.6367e-08" ixz="3.55462e-07" iyy="0.00536521" iyz="7.378e-09" izz="0.00759451"/>
      </inertial>
      <visual>
        <origin xyz="0 0 -0.05" rpy="-1.5708 0 0"/>
        <geometry>
          <mesh filename="package://kanga_core_description/meshes/core_2026/wheel_b.stl"/>
        </geometry>
        <material name="wheel_b_2_material">
          <color rgba="0.929412 0.0392157 0 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0.04" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.125" length="0.18"/>
        </geometry>
      </collision>
    </link>
    <joint name="${prefix}wheel_br_joint" type="continuous">
      <origin xyz="0.578642 -0.334079 -0.204625" rpy="0 0 0"/>
      <parent link="${prefix}right_suspension"/>
      <child link="${prefix}wheel_br"/>
      <!-- Match the positive-forward wheel convention used by drive feedback. -->
      <axis xyz="0 0 1"/>
      <limit effort="${wheel_joint_effort_limit_nm}" velocity="${wheel_joint_velocity_limit_rad_s}"/>
    </joint>

    <!-- Physical articulation range; state mapping lives in kanga_core_microcontroller. -->
    <joint name="${prefix}right_suspension_joint" type="revolute">
      <origin xyz="0.148499 -0.1911 0.0616" rpy="1.5708 -0 -3.14159"/>
      <parent link="${prefix}kanga_core"/>
      <child link="${prefix}right_suspension"/>
      <axis xyz="0 0 1"/>
      <limit effort="0" velocity="0" lower="-0.5235987755982988" upper="0.5235987755982988"/>
    </joint>

    <link name="${prefix}diff_bar">
      <inertial>
        <origin xyz="-0 0.00376465 -0.00953053" rpy="0 0 0"/>
        <mass value="0.4"/>
        <inertia ixx="8.38592e-05" ixy="-0" ixz="-0" iyy="0.00473068" iyz="1.00357e-05" izz="0.00472925"/>
      </inertial>
      <visual>
        <origin xyz="-0 -0.0766 0.260486" rpy="-1.5708 -0 0"/>
        <geometry>
          <mesh filename="package://kanga_core_description/meshes/core_2026/diff_bar.stl"/>
        </geometry>
        <material name="diff_bar_material">
          <color rgba="0.701961 0.701961 0.701961 1"/>
        </material>
      </visual>
      <!-- Differential bar simplified to its rectangular envelope. -->
      <collision>
        <origin xyz="0 0.0015 -0.00026" rpy="0 0 0"/>
        <geometry>
          <box size="0.4055 0.033 0.0625"/>
        </geometry>
      </collision>
    </link>
    <!-- Encoder joint; its measured angle drives the suspension state mapping. -->
    <joint name="${prefix}diff_bar_joint" type="revolute">
      <origin xyz="-0.301156 0 0.0766" rpy="1.5708 0 1.5708"/>
      <parent link="${prefix}kanga_core"/>
      <child link="${prefix}diff_bar"/>
      <axis xyz="0 0 1"/>
      <limit effort="0" velocity="0" lower="-1.2217304763960306" upper="1.2217304763960306"/>
    </joint>
  </xacro:macro>
</robot>
